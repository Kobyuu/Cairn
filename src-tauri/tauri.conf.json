{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cairn",
  "version": "0.1.0",
  "identifier": "com.kobyuu.cairn",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "foco",
        "url": "index.html?view=foco",
        "title": "Cairn",
        "width": 1100,
        "height": 760,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": false,
        "maximizable": false,
        "visible": false
      },
      {
        "label": "widget",
        "url": "index.html?view=widget",
        "title": "Cairn · widget",
        "width": 176,
        "height": 68,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "focus": false,
        "visible": false
      },
      {
        "label": "ambient",
        "url": "index.html?view=ambient",
        "title": "Cairn · ambiente",
        "width": 100,
        "height": 5,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "focus": false,
        "focusable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://ipc.localhost; script-src 'self'; style-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Juan Manuel Kobayashi",
    "copyright": "© 2026 Juan Manuel Kobayashi",
    "homepage": "https://cairn-roan.vercel.app/",
    "shortDescription": "Temporizador de pausas para Windows",
    "longDescription": "Cairn te avisa cuándo parar y no vuelve a contar hasta que confirmás que terminaste. El resto del día es una barra de tres píxeles.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["SpanishInternational", "English"]
      }
    }
  }
}
